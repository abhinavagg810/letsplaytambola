# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app — never put secrets here.
# The same names go into eas.json (native builds) and your web host's environment settings (Vercel / Netlify).

# Live backend: your Supabase project URL. Leave BOTH Supabase values empty for demo mode (on-device data, OTP is always 123456).
EXPO_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (Dashboard -> Project Settings -> API). Never the service-role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Your website address, no trailing slash. Used for invite links (https://…/g/CODE), link previews and the links that open the installed app.
EXPO_PUBLIC_WEB_URL=https://letsplaytambola.app

# Play Store page of the Android app, e.g. https://play.google.com/store/apps/details?id=com.letsplaytambola.app — empty hides the link on the web invite page.
EXPO_PUBLIC_PLAY_URL=
# App Store page of the iPhone app, e.g. https://apps.apple.com/in/app/letsplaytambola/id0000000000 — empty hides the link on the web invite page.
EXPO_PUBLIC_APPSTORE_URL=

# 1 to show ads, 0 to hide them (ads are not wired in yet — see docs/ADS.md).
EXPO_PUBLIC_ADS_ENABLED=0

# --- Web build only (not bundled into the app; read by scripts/web-postbuild.js). Optional: you can edit public/.well-known/* instead.
# Apple Team ID (10 characters) for public/.well-known/apple-app-site-association.
# APPLE_TEAM_ID=
# SHA-256 certificate fingerprint(s) of the Android app, comma-separated, for public/.well-known/assetlinks.json.
# ANDROID_SHA256_FINGERPRINTS=
