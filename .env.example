# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app — never put secrets here.

# Live backend. Leave BOTH empty to run in demo mode (on-device data, OTP is always 123456).
# Supabase dashboard -> Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used to build invite links (https://…/g/CODE). No trailing slash.
EXPO_PUBLIC_WEB_URL=https://letsplaytambola.com

# 1 to show ads, 0 to hide them.
EXPO_PUBLIC_ADS_ENABLED=0
