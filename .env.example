# Copy to .env.local for local work; on Vercel add the same names under Project → Settings → Environment Variables.
# With none of these set the app still runs: games are kept in memory (single process, lost on restart) and browsers poll every 1.5s.

# Supabase project URL (Dashboard → Project Settings → API → Project URL). Server only.
SUPABASE_URL=
# Supabase service_role / secret key (Project Settings → API keys). Server only — NEVER expose it to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# The same project URL again, for the browser: used only to listen for the realtime "something changed" ping.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key (safe in the browser: the database gives this key no access to any table).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of the site, used in share links, e.g. https://letsplaytambola.com (no trailing slash). Empty = use the address in the browser.
NEXT_PUBLIC_SITE_URL=
# Optional, for load tests only: set to 1 to switch off the API rate limits.
# RATE_LIMIT_DISABLED=

# --- Admin panel (/admin) — optional. See docs/ADMIN.md. Leave both empty to keep the admin area switched off. ---
# The email the operator signs in with (placeholder shown; use your own). Server only.
ADMIN_EMAIL=
# The password the operator signs in with — long and random, used nowhere else. Server only; on Vercel mark it "Sensitive". Never commit a real one.
ADMIN_PASSWORD=
# Optional: a long random string used to sign admin sessions. Changing it signs the admin out. If empty, the Supabase service key is used instead.
ADMIN_SESSION_SECRET=
# Example for local work only (.env.local):  ADMIN_EMAIL=admin@example.com   ADMIN_PASSWORD=change-me

# ---- Ads (optional; see docs/ADS.md). Leave empty to show no ads. ----
# Google AdSense publisher id, e.g. ca-pub-1234567890123456. Setting it loads the AdSense script and serves /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit ids (numbers) created in AdSense. A placement with no id shows nothing.
NEXT_PUBLIC_ADSENSE_SLOT_LOBBY=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
